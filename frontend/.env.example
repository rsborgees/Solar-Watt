# Pra onde os leads do simulador são enviados (ver src/leads.js).
# Copie este arquivo pra ".env" e preencha UMA das três opções abaixo
# (checadas nesta ordem: VITE_LEAD_ENDPOINT > VITE_LEAD_WEB3FORMS_KEY > VITE_LEAD_EMAIL).

# Recomendado: chave grátis de https://web3forms.com — cadastre um e-mail lá,
# a chave chega na hora (sem link de ativação frágil).
VITE_LEAD_WEB3FORMS_KEY=

# Alternativa mais simples, mas menos estável: e-mail que recebe cada lead
# via formsubmit.co (grátis, sem cadastro prévio — exige confirmar um
# e-mail de ativação no primeiro envio, que às vezes dá erro 500 do lado deles).
VITE_LEAD_EMAIL=

# Avançado: endpoint próprio que aceite POST JSON. Tem prioridade sobre os dois acima.
VITE_LEAD_ENDPOINT=

# URL da API do backend (ver pasta backend/) que atende a Área do Cliente.
# Sem isso, /portal mostra erro amigável em vez de travar o site.
VITE_PORTAL_API_URL=
